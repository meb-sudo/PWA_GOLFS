# ---- BFF ----
PORT=3001
NODE_ENV=development

# Secret de signature des cookies de session (32+ caracteres)
SESSION_SECRET=changez-moi-par-une-chaine-aleatoire-de-32-caracteres-minimum

# Groupe par defaut quand l'hote appelant n'est pas reconnu
DEFAULT_GROUP=CLUBS_GRP_MADAEF
# Palette de l interface, independante du groupe.
# Vide = les couleurs suivent le groupe. Renseigne = elles sont figees.
THEME=CLUBS_GRP_PRESTIGIA

# Mapping hote -> groupe (multi-club). Vide = on utilise DEFAULT_GROUP.
# Permet de basculer entre sous-domaines et domaine unique sans changer le code.
GROUP_HOST_MAP=prestigia.golfs.ma:CLUBS_GRP_PRESTIGIA,yapo.golfs.ma:CLUBS_GRP_YAPO,madaef.golfs.ma:CLUBS_GRP_MADAEF

# Origine autorisee pour la PWA en developpement
WEB_ORIGIN=http://localhost:5180

# API amont
API_GOLFS=https://rest-lg-mg.golfs.ma/MG_LG_REST
API_LOGIGOLF=https://rest.logigolf.com/LOGIGOLF
API_FRMG=https://rest.frmg.ma/FRMG_REST
API_IMAGES=https://images.golfs.ma

# Mode lecture seule : bloque tout appel amont qui ecrit (reservation, annulation...).
# Laisser a true tant qu'aucun environnement de recette n'est confirme.
READ_ONLY=true
# Affiche le code de double authentification dans le journal du BFF, pour la
# recette locale quand on n a pas acces a la boite mail.
# Ce n est pas un contournement : le code reste verifie cote serveur.
# Sans effet si NODE_ENV=production.
DEV_LOG_AUTH_CODE=false

# ---- WEB (prefixe VITE_) ----
VITE_API_BASE=/api
