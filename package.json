{
  "name": "pwa-golf",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:bff": "npm run dev --workspace=@golf/bff",
    "dev:web": "npm run dev --workspace=@golf/web",
    "build": "npm run build --workspace=@golf/contracts && npm run build --workspace=@golf/bff && npm run build --workspace=@golf/web",
    "typecheck": "tsc -b packages/contracts apps/bff apps/web"
  },
  "engines": { "node": ">=20.11" }
}
