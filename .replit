modules = ["nodejs-20", "web"]

# Bouton "Run" en dev : lance le front (Vite) + le BFF avec rechargement.
run = "npm run dev"
entrypoint = "apps/bff/src/server.ts"

# Deploiement (Reserved VM = machine allumee en continu -> sessions stables).
# Un seul service : on builde tout, puis le BFF sert la PWA + /api.
[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm ci && npm run build"]
run = ["sh", "-c", "node apps/bff/dist/server.js"]

[[ports]]
localPort = 3001
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
API_FRMG = "https://rest.frmg.ma/FRMG_REST"
API_GOLFS = "https://rest-lg-mg.golfs.ma/MG_LG_REST"
API_IMAGES = "https://images.golfs.ma"
API_LOGIGOLF = "https://rest.logigolf.com/LOGIGOLF"
DEFAULT_GROUP = "CLUBS_GRP_ALMAADEN"
NODE_ENV = "production"
READ_ONLY = "false"
THEME = "CLUBS_GRP_PRESTIGIA"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node apps/bff/dist/server.js"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"
